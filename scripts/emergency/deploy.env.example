# Temporary emergency deploy config.
# Copy this file to:  scripts/emergency/deploy.env   (it is gitignored)
# and fill in the values. DO NOT commit deploy.env.
#
# A values like VM_HOST/VM_USER are the same ones used by the automated
# deploy (GitHub secrets VM_HOST / VM_USER / VM_SSH_KEY / GHCR_TOKEN),
# but here you supply them locally.

# VPS hostname or IP
VM_HOST=

# SSH user on the VPS
VM_USER=

# Path to your VPS SSH private key
VM_SSH_KEY=

# Directory on the VPS that holds blog/docker-compose.yml
# NOTE: use the ABSOLUTE remote path (e.g. /home/ubuntu/MyPage/blog).
# Do NOT use ~/ here - it expands to your LOCAL home and breaks the deploy.
VM_DEPLOY_PATH=

# GHCR image prefix. Owner must be able to push to these repos.
GHCR_IMAGE=
