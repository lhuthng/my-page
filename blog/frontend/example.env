# Local development runs the backend on 5174 and this dev server on 5175 (the
# same pair backend/example.env sets). `PORT` overrides the dev server's port.
API_URL=http://localhost:5174
# Set this to the public API origin in production; pointing it at
# http://localhost:5174 in dev sends browser media fetches straight to the
# local backend instead of through the /api proxy.
BACKEND_ORIGIN=https://your-backend-domain.com
ALLOWED_HOSTS=blog.huuthangle.site
TRUSTED_ORIGINS=http://localhost:5175,https://blog.huuthangle.site,https://portfolio.huuthangle.site
GIPHY_API_KEY=your_giphy_api_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

PUBLIC_PORTFORLIO_URL=your_portfolio_url
