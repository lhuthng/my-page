# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default - path is relative to the working directory /app)
DATABASE_URL=sqlite:data/blog.db

# PostgreSQL example (swap sqlx feature to "postgres" in Cargo.toml to use)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────────
# Port the dev server binds. Local development puts the backend on 5174 and the
# frontend dev server on 5175 (frontend/vite.config.js).
#
# Docker pins its own in docker-compose.yml, so this line never moves the
# container. Unusable values (empty, non-numeric, or 0 — the OS reads 0 as
# "any free port") are ignored in favour of 5174, so stray environment can't
# silently move the server off the port the frontend's API_URL points at.
PORT=5174

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET

# How long access tokens stay valid (hours). Default: 24
ACCESS_JWT_EXP_HOURS=24

# How long refresh tokens stay valid (hours). Default: 360  (~15 days)
REFRESH_JWT_EXP_HOURS=360

# ── Media Storage ─────────────────────────────────────────────────────────────
# Directory where uploaded files are stored.
MEDIA_PATH=./media

# Where the bytes live. Everything — images, video, covers, avatars, models —
# is on MEDIA_PATH, with one exception: audiobook audio can additionally be
# stored in the bucket and served from there.
#
# `fs` (the default) keeps audio on disk too and the backend serves it. `r2`
# also writes each audio upload to the bucket and serves from there, falling
# back to MEDIA_PATH for a track the bucket does not have yet — which is what
# lets the move happen per file instead of all at once.
#
# There is deliberately no `auto` here, unlike STORAGE_BACKEND: audio moving to
# the bucket is a decision, not a side effect of someone configuring R2 for the
# v86 artifacts.
# AUDIO_BACKEND=fs

# `redirect` (default) answers /media/i/{short_name} with a 302 to the object's
# public URL, so the bytes never pass through the VM. `proxy` streams them
# through the backend instead: slower, but useful for debugging and for a client
# that mishandles redirects.
# AUDIO_READ=redirect
#
# Connection details come from the R2_* block below — audio shares that bucket
# with the v86 artifacts and is kept apart by the `audio/` prefix. So
# AUDIO_BACKEND=r2 needs R2_PUBLIC_URL set, because that is where audio is
# served from.
#
# To move existing audio into the bucket: deploy this build, then on the VM run
# `./backfill-audio.sh --upload` from `blog/backend`, then set AUDIO_BACKEND=r2
# and restart. The backfill reads the bucket from R2_*, not from AUDIO_BACKEND, so
# it runs while audio is still being served from disk — do not flip the switch
# first. The backfill report is what tells you whether the disk copy can be
# deleted; see docs/guides/operations.md.

# ── Project Demos Storage ─────────────────────────────────────────────────────────────
# Directory where uploaded files are stored.
PROJECT_DEMOS_PATH=./project-demos
PROJECT_JSDOS_MAX_BYTES=524288000
PROJECT_JSDOS_CHUNK_BYTES=8388608
PROJECT_JSDOS_UPLOAD_TTL_HOURS=24
PROJECT_V86_BASE_MAX_BYTES=2147483648
PROJECT_V86_GAME_ZIP_MAX_BYTES=524288000
PROJECT_V86_GAME_EXTRACTED_MAX_BYTES=1073741824
PROJECT_V86_GAME_MAX_FILES=10000
PROJECT_V86_UPLOAD_CHUNK_BYTES=8388608
PROJECT_V86_DOWNLOAD_CHUNK_BYTES=262144
PROJECT_V86_ASSETS_DIR=./assets
PROJECT_V86_XORRISO_BIN=xorriso

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to call the /mail/contact-form endpoint.
# Use a comma-separated list. Local dev example:
# ALLOWED_ORIGINS=http://localhost:3004,https://portfolio.huuthangle.site
ALLOWED_ORIGIN=https://your-portfolio-domain.com

# Public URL of the blog frontend, used for verification links.
APP_BASE_URL=http://localhost:5175

# ── Email / SMTP (lettre) ─────────────────────────────────────────────────────
# Optional: use Brevo's HTTP API instead of SMTP.
# This must be a Brevo API key for POST https://api.brevo.com/v3/smtp/email
# BREVO_API_KEY=your-brevo-api-key
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-login
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=contact@your-domain.com
# SMTP_TO=your-real-inbox@example.com

# ── Object Storage (shared by v86 artifacts and audiobook audio) ─────────────
# One bucket holds both. The v86 artifacts (system IMG chunks, game disks, ISOs,
# snapshots, saves) live under `v86/`; audiobook audio lives under `audio/`.
# Nothing else is in the bucket — images, covers, avatars, video and models stay
# on MEDIA_PATH. The two are switched independently — STORAGE_BACKEND here,
# AUDIO_BACKEND above — so either can be on the bucket or on the disk on its own.
#
# `auto` (default) uses R2 when the R2_* variables below are set and falls back
# to the local filesystem otherwise. `fs` keeps everything on disk under
# PROJECT_DEMOS_PATH (no R2 credentials needed); `r2` requires the R2_*
# variables. R2_PUBLIC_URL is ignored in fs mode — artifacts are then served by
# the backend at relative URLs.
# STORAGE_BACKEND=auto
#
# To move existing artifacts out of R2: deploy this build, run
# ./sync_r2_to_fs.sh on the VM, set STORAGE_BACKEND=fs, and restart. Verify a
# game boots before deleting the bucket's v86/ prefix to reclaim space.

# --- Cloudflare Storage ---
# R2_PUBLIC_URL is the bucket's public domain. Both the v86 artifacts and
# audiobook audio are served from it, so AUDIO_BACKEND=r2 requires it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional: override the S3 endpoint URL, e.g. to point at a local S3-compatible
# server (MinIO, etc.) for dev instead of Cloudflare R2. When unset, defaults to
# https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=http://localhost:9000

# Local dev storage: run `make minio-up` (from blog/), then uncomment this block
# instead of the R2_* values above. `make backend-local-storage` does both for you
# and tears the container down on exit.
# R2_ACCOUNT_ID=dev
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_BUCKET=dev-bucket
# R2_ENDPOINT=http://localhost:9000
# R2_PUBLIC_URL=http://localhost:9000/dev-bucket
