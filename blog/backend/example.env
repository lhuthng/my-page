# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default - path is relative to the working directory /app)
DATABASE_URL=sqlite:data/blog.db

# PostgreSQL example (swap sqlx feature to "postgres" in Cargo.toml to use)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_YOUR_JWT_SECRET

# How long access tokens stay valid (hours). Default: 24
ACCESS_JWT_EXP_HOURS=24

# How long refresh tokens stay valid (hours). Default: 360  (~15 days)
REFRESH_JWT_EXP_HOURS=360

# ── Media Storage ─────────────────────────────────────────────────────────────
# Directory where uploaded files are stored.
MEDIA_PATH=./media

# ── Project Demos Storage ─────────────────────────────────────────────────────────────
# Directory where uploaded files are stored.
PROJECT_DEMOS_PATH=./project-demos

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to call the /mail/contact-form endpoint.
# Use a comma-separated list. Local dev example:
# ALLOWED_ORIGINS=http://localhost:3004,https://portfolio.huuthangle.site
ALLOWED_ORIGIN=https://your-portfolio-domain.com

# Public URL of the blog frontend, used for verification links.
APP_BASE_URL=http://localhost:5173

# ── Email / SMTP (lettre) ─────────────────────────────────────────────────────
# Optional: use Brevo's HTTP API instead of SMTP.
# This must be a Brevo API key for POST https://api.brevo.com/v3/smtp/email
# BREVO_API_KEY=your-brevo-api-key
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-login
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=contact@your-domain.com
# SMTP_TO=your-real-inbox@example.com
